# Copy to .env (git-ignored) and fill in locally. Never paste these values into chat, issues, PRs or Notion.
# Oura API v2, OAuth2 authorization-code flow (REQ-OURA-01). Values from https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must match the redirect URI registered for the app exactly.
OURA_REDIRECT_URI=http://localhost:8080/callback
# Minimum scopes (REQ-OURA-02), space-separated.
OURA_SCOPES=daily heartrate
# Access/refresh tokens are NOT kept here: the app stores them in Windows Credential Manager
# (keyring service "tinyml-oura") on the laptop, or an encrypted file on the hub (REQ-OURA-03).
